---
import { GRAPHQL_HOST } from 'astro:env/client';
import './MultiSelect.css';

const json = await fetch(GRAPHQL_HOST, {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({
    query: `
      query Items {
        items
      }
    `,
  }),
}).then((res) => res.json());

const { items }: { items: Array<string> } = json.data;
const itemsFromStorage = Astro.props.itemsFromStorage;
---

<div role="search" data-items-from-storage={JSON.stringify(itemsFromStorage)} data-items={JSON.stringify(items)}>
  <form class="multiSelect__form">
    <input class="multiSelect__input" placeholder="Search..." type="search" value="" />

    <ul class="multiSelect__list"></ul>

    <input class="multiSelect__submit" type="submit" value="Apply" />
  </form>
</div>

<script src="./MultiSelect.ts"></script>
